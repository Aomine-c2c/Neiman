# NEIMAN API Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://NEIMAN:SET_A_URL_SAFE_PASSWORD@localhost:5432/NEIMAN

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DISABLE_AUTH=false
# Set only for first-admin bootstrap; do not commit a value.
NEIMAN_BOOTSTRAP_ADMIN_PASSWORD=
NEIMAN_BOOTSTRAP_ADMIN_EMAIL=admin@neiman.ai
NEIMAN_BOOTSTRAP_ADMIN_USERNAME=admin

# Environment
DEBUG=true
ENVIRONMENT=development
APP_NAME=NEIMAN
APP_VERSION=1.0.2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# LLM Providers (add your API keys)
ENABLE_SIMULATION_MODE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_AI_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=
KILO_API_KEY=
META_API_KEY=
OLLAMA_API_KEY=
HUGGINGFACE_API_KEY=
HF_TOKEN=
KIMI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
Z_AI_API_KEY=
ZHIPU_API_KEY=
ALIBABACLOUD_API_KEY=
ALIBABA_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
POOLSIDE_API_KEY=
ARCEE_API_KEY=
XIAOMIMIMO_API_KEY=
MIMO_API_KEY=
MINIMAX_API_KEY=
UPSTAGE_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@NEIMAN.local

# Sentry (optional)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
